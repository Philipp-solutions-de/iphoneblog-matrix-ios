+    /// iPhoneBlog: where the reader is, for ChatReadPositions: the event at the top of the screen,
+    /// or nil at the newest message. Rooms and threads only.
+    private func recordReadPosition() {
+        let state = coordinator.context.viewState
+        let thread: String?
+        switch state.timelineKind {
+        case .live, .detached: thread = nil
+        case .thread(let rootEventID): thread = rootEventID
+        default: return
+        }
+        guard !timelineItemsIDs.isEmpty else { return }
+        ChatReadPositions.shared.record(topmostVisibleEventID(), user: state.ownUserID, room: state.roomID, thread: thread)
+    }
+    
+    /// The topmost fully visible item with an event; the table is flipped, so the highest row.
+    private func topmostVisibleEventID() -> String? {
+        let atNewest = tableView.contentOffset.y <= 1 && (isLive || paginationState.forward == .endReached)
+        guard !atNewest, let paths = tableView.indexPathsForVisibleRows?.sorted(by: >) else { return nil }
+        var partlyVisible: String?
+        for path in paths {
+            guard let id = dataSource?.itemIdentifier(for: path), let eventID = timelineItemsDictionary[id]?.identifier.eventID else { continue }
+            if tableView.bounds.contains(tableView.rectForRow(at: path)) { return eventID }
+            if partlyVisible == nil { partlyVisible = eventID }
+        }
+        return partlyVisible
+    }
