# TestFlight for the iphoneblog chat app. Everything runs with an App Store Connect API key
# from repository secrets; nobody's Apple ID password is used. Setup: docs/apple-setup.md.
#
#   bundle exec fastlane ios register   identifiers and capabilities (Apple setup workflow)
#   bundle exec fastlane ios beta       build, sign and upload to TestFlight
#
# Environment:
#   ASC_KEY_ID, ASC_ISSUER_ID, ASC_KEY_P8_BASE64   the API key (secrets)
#   APPLE_TEAM_ID                                  the team (repository variable)
#   BUILD_NUMBER                                   CFBundleVersion for the upload

require "base64"
require "tmpdir"
require "securerandom"
require "shellwords"
require "xcodeproj"

default_platform(:ios)

ROOT = File.expand_path("..", __dir__)

def brand(key)
  value = File.read(File.join(ROOT, "brand.env"))[/^#{key}="?([^"\n]*)"?/, 1]
  UI.user_error!("brand.env has no #{key}") if value.to_s.empty?
  value
end

def team_id
  ENV.fetch("APPLE_TEAM_ID") { UI.user_error!("APPLE_TEAM_ID is not set") }
end

# Writes the key for xcodebuild (it needs a file) and returns fastlane's api_key hash.
def api_key
  @api_key ||= begin
    key_id = ENV.fetch("ASC_KEY_ID")
    path = File.join(Dir.tmpdir, "AuthKey_#{key_id}.p8")
    File.write(path, Base64.decode64(ENV.fetch("ASC_KEY_P8_BASE64")))
    File.chmod(0o600, path)
    @key_path = path
    app_store_connect_api_key(
      key_id: key_id,
      issuer_id: ENV.fetch("ASC_ISSUER_ID"),
      key_filepath: path,
      in_house: false
    )
  end
end

def app_store_profile(key, identifier, force: false)
  get_provisioning_profile(api_key: key, app_identifier: identifier, team_id: team_id, force: force,
                           output_path: File.join(ROOT, "build/profiles"))
  [lane_context[SharedValues::SIGH_NAME], lane_context[SharedValues::SIGH_PROFILE_PATH]]
end

def profile_has_group?(path, group)
  plist = `security cms -D -i #{Shellwords.escape(path)}`
  plist.include?("<string>#{group}</string>")
end

def profile_has_associated_domains?(path)
  plist = `security cms -D -i #{Shellwords.escape(path)}`
  plist.include?("<key>com.apple.developer.associated-domains</key>")
end

platform :ios do
  # Builds, signs and exports the App Store .ipa; returns the API key.
  # Signing is manual: the team's one Apple Distribution certificate comes from the
  # environment secrets DIST_CERT_P12_BASE64 and DIST_CERT_PASSWORD into a throwaway
  # keychain, and sigh fetches (or creates) the App Store profile through the API.
  # No device, no Apple ID, no xcodebuild login.
  private_lane :archive do
    key = api_key
    sh(File.join(ROOT, "scripts/configure.sh"))

    keychain = File.join(Dir.tmpdir, "iphoneblog-signing.keychain-db")
    keychain_password = SecureRandom.hex(24)
    create_keychain(path: keychain, password: keychain_password, default_keychain: false,
                    unlock: true, timeout: 3600, lock_when_sleeps: false, add_to_search_list: true)
    p12 = File.join(Dir.tmpdir, "distribution.p12")
    File.binwrite(p12, Base64.decode64(ENV.fetch("DIST_CERT_P12_BASE64")))
    File.chmod(0o600, p12)
    begin
      import_certificate(certificate_path: p12, certificate_password: ENV.fetch("DIST_CERT_PASSWORD"),
                         keychain_path: keychain, keychain_password: keychain_password, log_output: false)
    ensure
      File.delete(p12) if File.exist?(p12)
    end

    project = File.join(ROOT, "iphoneblog.xcodeproj")
    profiles = {}
    bundle_id = brand("BUNDLE_ID")
    group = brand("APP_GROUP_ID")
    # Capabilities first: a profile carries only what the App ID has switched on. Adds only
    # what is missing (Associated Domains came after the first builds).
    register
    { "App" => bundle_id, "NotificationExtension" => "#{bundle_id}.nse" }.each do |target, identifier|
      name, path = app_store_profile(key, identifier)
      # A profile made before Associated Domains was on lacks it; make it once more.
      if target == "App" && !profile_has_associated_domains?(path)
        UI.important("#{identifier}: profile lacks associated domains, regenerating")
        name, path = app_store_profile(key, identifier, force: true)
        UI.user_error!("#{identifier}: Associated Domains is not on for the id") unless profile_has_associated_domains?(path)
      end
      # A profile made before the app group was tied to the id lacks it; make it once more.
      unless profile_has_group?(path, group)
        UI.important("#{identifier}: profile lacks #{group}, regenerating")
        name, path = app_store_profile(key, identifier, force: true)
        UI.user_error!("#{identifier}: #{group} is not tied to the id (docs/apple-setup.md step 6)") unless profile_has_group?(path, group)
      end
      profiles[identifier] = name
      update_code_signing_settings(path: project, targets: [target], use_automatic_signing: false,
                                   team_id: team_id, code_sign_identity: "Apple Distribution",
                                   profile_name: name, bundle_identifier: identifier)
    end

    # Frameworks built into the app (ChatKit) sign with the same identity and need no profile.
    Xcodeproj::Project.open(project).targets
                      .select { |t| t.product_type == "com.apple.product-type.framework" }
                      .each do |t|
      update_code_signing_settings(path: project, targets: [t.name], use_automatic_signing: false,
                                   team_id: team_id, code_sign_identity: "Apple Distribution")
    end

    build_app(
      project: project,
      scheme: "iphoneblog",
      configuration: "Release",
      output_directory: File.join(ROOT, "build/ipa"),
      codesigning_identity: "Apple Distribution",
      xcargs: [
        "-skipPackagePluginValidation",
        "-skipMacroValidation",
        "OTHER_CODE_SIGN_FLAGS='--keychain #{keychain}'",
        # Swift packages build frameworks and resource bundles (MatrixRustSDK, Kingfisher,
        # DTCoreText, Compound's tokens, ...) that are signed automatically unless told otherwise,
        # and automatic signing clashes with our identity. On the command line these reach every
        # target: manual, Apple Distribution, our team. Profiles stay per target in the project
        # (app and extension); frameworks and bundles need none.
        "DEVELOPMENT_TEAM=#{team_id}",
        "CODE_SIGN_STYLE=Manual",
        "CODE_SIGN_IDENTITY='Apple Distribution'",
        "CURRENT_PROJECT_VERSION=#{ENV.fetch('BUILD_NUMBER')}"
      ].join(" "),
      export_team_id: team_id,
      export_options: {
        method: "app-store-connect",
        signingStyle: "manual",
        teamID: team_id,
        signingCertificate: "Apple Distribution",
        provisioningProfiles: profiles
      }
    )

    key
  end

  desc "Register the bundle ids and switch on their capabilities through the API"
  lane :register do
    Spaceship::ConnectAPI.token = Spaceship::ConnectAPI::Token.from(hash: api_key)
    bundle_id = brand("BUNDLE_ID")
    store_name = brand("APP_STORE_NAME")
    ids = {
      bundle_id => store_name,
      "#{bundle_id}.nse" => "#{store_name} Notifications"
    }
    caps = Spaceship::ConnectAPI::BundleIdCapability::Type
    ids.each do |identifier, name|
      bundle = Spaceship::ConnectAPI::BundleId.find(identifier)
      if bundle
        UI.message("#{identifier}: already registered")
      else
        bundle = Spaceship::ConnectAPI::BundleId.create(name: name, platform: "IOS", identifier: identifier)
        UI.success("#{identifier}: registered")
      end
      # The app receives pushes and uses passkeys in its web view (Associated Domains);
      # app and extension share the app group.
      wanted = identifier == bundle_id ? [caps::PUSH_NOTIFICATIONS, caps::APP_GROUPS, caps::ASSOCIATED_DOMAINS] : [caps::APP_GROUPS]
      present = bundle.get_capabilities.map(&:capability_type)
      wanted.each do |cap|
        if present.include?(cap)
          UI.message("#{identifier}: #{cap} already on")
        else
          # POST /v1/bundleIdCapabilities. update_capability (PATCH on the bundle id) answers
          # "Unauthenticated" for an API key.
          bundle.create_capability(cap)
          UI.success("#{identifier}: #{cap} on")
        end
      end
    end
  end

  desc "Create the team's Apple Distribution certificate from a CSR (certificate workflow)"
  lane :create_certificate do
    Spaceship::ConnectAPI.token = Spaceship::ConnectAPI::Token.from(hash: api_key)
    csr = ENV.fetch("CSR_PEM")
    UI.user_error!("CSR_PEM is not a certificate signing request") unless csr.include?("BEGIN CERTIFICATE REQUEST")

    existing = Spaceship::ConnectAPI::Certificate.all(filter: { certificateType: "DISTRIBUTION" })
    existing.each { |c| UI.message("existing: #{c.name} #{c.serial_number} until #{c.expiration_date}") }

    cert = Spaceship::ConnectAPI::Certificate.create(certificate_type: "DISTRIBUTION", csr_content: csr)
    UI.success("created: #{cert.name} #{cert.serial_number} until #{cert.expiration_date}")
    # The certificate is public (it holds no private key); printing it is safe.
    puts "CERTIFICATE_BASE64_BEGIN"
    puts cert.certificate_content
    puts "CERTIFICATE_BASE64_END"
  end

  desc "The newest builds in App Store Connect with Apple's processing state"
  lane :build_status do
    Spaceship::ConnectAPI.token = Spaceship::ConnectAPI::Token.from(hash: api_key)
    app = Spaceship::ConnectAPI::App.find(brand("BUNDLE_ID"))
    UI.user_error!("no app record for #{brand('BUNDLE_ID')}") unless app
    Spaceship::ConnectAPI::Build.all(app_id: app.id, sort: "-uploadedDate", limit: 8).each do |b|
      UI.message("#{b.app_version} (#{b.version}) #{b.processing_state} uploaded #{b.uploaded_date}")
    end

    # Uploads Apple refused never become builds; the build upload records keep the reason.
    require "net/http"
    require "json"
    token = Spaceship::ConnectAPI.token.text
    uri = URI("https://api.appstoreconnect.apple.com/v1/apps/#{app.id}/buildUploads?limit=6&sort=-uploadedDate")
    response = Net::HTTP.get_response(uri, "Authorization" => "Bearer #{token}")
    UI.message("buildUploads: HTTP #{response.code}")
    (JSON.parse(response.body)["data"] || []).each do |upload|
      a = upload["attributes"] || {}
      UI.message("upload #{a['cfBundleShortVersionString']} (#{a['cfBundleVersion']}) #{a.dig('state', 'state') || a['state']} #{a['uploadedDate']}")
      %w[errors warnings infos].each do |kind|
        (a.dig("state", kind) || []).each { |e| UI.message("  #{kind}: #{e['code']} #{e['description']}") }
      end
    end
    UI.message(response.body[0, 600]) unless response.code == "200"
  end

  desc "TestFlight groups, their builds and Beta App Review; with INVITE_EMAIL and INVITE_GROUP, adds that tester"
  lane :testers do
    require "net/http"
    require "json"
    Spaceship::ConnectAPI.token = Spaceship::ConnectAPI::Token.from(hash: api_key)
    app = Spaceship::ConnectAPI::App.find(brand("BUNDLE_ID"))
    UI.user_error!("no app record for #{brand('BUNDLE_ID')}") unless app
    asc = lambda do |method, path, body = nil|
      uri = URI("https://api.appstoreconnect.apple.com#{path}")
      request = { post: Net::HTTP::Post, patch: Net::HTTP::Patch }.fetch(method, Net::HTTP::Get).new(uri)
      request["Authorization"] = "Bearer #{Spaceship::ConnectAPI.token.text}"
      if body
        request["Content-Type"] = "application/json"
        request.body = JSON.generate(body)
      end
      response = Net::HTTP.start(uri.host, uri.port, use_ssl: true) { |http| http.request(request) }
      [response.code, (JSON.parse(response.body) rescue {})]
    end

    _, groups = asc.call(:get, "/v1/apps/#{app.id}/betaGroups?limit=50")
    (groups["data"] || []).each do |g|
      a = g["attributes"]
      _, builds = asc.call(:get, "/v1/betaGroups/#{g['id']}/builds?limit=10&sort=-uploadedDate")
      _, testers = asc.call(:get, "/v1/betaGroups/#{g['id']}/betaTesters?limit=200")
      UI.message("group \"#{a['name']}\" #{a['isInternalGroup'] ? 'internal' : 'external'} " \
                 "testers=#{(testers['data'] || []).size} builds=#{(builds['data'] || []).map { |b| b.dig('attributes', 'version') }.join(',')}")
    end
    _, recent = asc.call(:get, "/v1/builds?filter[app]=#{app.id}&sort=-uploadedDate&limit=4&include=buildBetaDetail,betaAppReviewSubmission")
    (recent["data"] || []).each do |b|
      detail = (recent["included"] || []).find { |i| i["type"] == "buildBetaDetails" && i["id"] == b.dig("relationships", "buildBetaDetail", "data", "id") }
      review = (recent["included"] || []).find { |i| i["type"] == "betaAppReviewSubmissions" && i["id"] == b.dig("relationships", "betaAppReviewSubmission", "data", "id") }
      UI.message("build #{b.dig('attributes', 'version')}: internal=#{detail&.dig('attributes', 'internalBuildState')} " \
                 "external=#{detail&.dig('attributes', 'externalBuildState')} review=#{review&.dig('attributes', 'betaReviewState') || 'none'}")
    end

    # Team members and open invitations, as counts (names and addresses stay out of the log).
    _, users = asc.call(:get, "/v1/users?limit=200")
    _, pending = asc.call(:get, "/v1/userInvitations?limit=200")
    UI.message("team: #{(users['data'] || []).size} users, #{(pending['data'] || []).size} open invitations")

    # Why a tester sees nothing: the group's builds and "all builds" setting, each tester's
    # state, and the newest builds' states. With TESTERS_FIX=true: all builds on for internal
    # groups, the newest valid builds added, and a TestFlight invitation to each tester.
    if ENV["TESTERS_CHECK"] == "true" || ENV["TESTERS_FIX"] == "true"
      fix = ENV["TESTERS_FIX"] == "true"
      _, builds = asc.call(:get, "/v1/builds?filter[app]=#{app.id}&sort=-uploadedDate&limit=4&include=buildBetaDetail")
      valid = (builds["data"] || []).select { |b| b.dig("attributes", "processingState") == "VALID" && !b.dig("attributes", "expired") }
      (builds["data"] || []).each do |b|
        a = b["attributes"]
        UI.message("build #{a['version']}: #{a['processingState']} expired=#{a['expired']} encryption=#{a['usesNonExemptEncryption'].inspect} expires=#{a['expirationDate']}")
      end
      (groups["data"] || []).each do |g|
        a = g["attributes"]
        UI.message("group \"#{a['name']}\" internal=#{a['isInternalGroup']} allBuilds=#{a['hasAccessToAllBuilds'].inspect}")
        if fix && a["isInternalGroup"] && a["hasAccessToAllBuilds"] != true
          code, = asc.call(:patch, "/v1/betaGroups/#{g['id']}", { data: { type: "betaGroups", id: g["id"], attributes: { hasAccessToAllBuilds: true } } })
          UI.message("  all builds on: HTTP #{code}")
        end
        if fix && !valid.empty?
          code, body = asc.call(:post, "/v1/betaGroups/#{g['id']}/relationships/builds", { data: valid.map { |b| { type: "builds", id: b["id"] } } })
          UI.message("  builds #{valid.map { |b| b.dig('attributes', 'version') }.join(',')} added: HTTP #{code}")
          (body["errors"] || []).each { |e| UI.message("    #{e['code']}: #{e['detail']}") }
        end
        _, gb = asc.call(:get, "/v1/betaGroups/#{g['id']}/builds?limit=10")
        UI.message("  builds now: #{(gb['data'] || []).map { |b| b.dig('attributes', 'version') }.join(',')}")
        _, testers = asc.call(:get, "/v1/betaGroups/#{g['id']}/betaTesters?limit=50")
        (testers["data"] || []).each_with_index do |t, i|
          ta = t["attributes"]
          UI.message("  tester #{i + 1}: state=#{ta['state']} inviteType=#{ta['inviteType']}")
          next unless fix && ta["state"] != "ACCEPTED" && ta["state"] != "INSTALLED"
          code, body = asc.call(:post, "/v1/betaTesterInvitations", { data: { type: "betaTesterInvitations",
            relationships: { app: { data: { type: "apps", id: app.id } }, betaTester: { data: { type: "betaTesters", id: t["id"] } } } } })
          UI.message("    TestFlight invitation sent: HTTP #{code}")
          (body["errors"] || []).each { |e| UI.message("      #{e['code']}: #{e['detail']}") }
        end
      end
      next
    end

    email = ENV["INVITE_EMAIL"].to_s.strip
    next if email.empty?
    known = ->(list) { (list["data"] || []).any? { |u| u.dig("attributes", "username").to_s.casecmp?(email) || u.dig("attributes", "email").to_s.casecmp?(email) } }
    UI.message("this person: #{known.call(users) ? 'team member' : known.call(pending) ? 'invited, not yet accepted' : 'not on the team'}")

    # A team invitation (role Marketing, this app only, no certificates): an internal tester
    # must be on the team first.
    if ENV["TEAM_INVITE"] == "true" && !known.call(users) && !known.call(pending)
      code, body = asc.call(:post, "/v1/userInvitations", {
        data: { type: "userInvitations",
                attributes: { email: email, firstName: ENV.fetch("INVITE_FIRST"), lastName: ENV.fetch("INVITE_LAST"),
                              roles: ["MARKETING"], allAppsVisible: false, provisioningAllowed: false },
                relationships: { visibleApps: { data: [{ type: "apps", id: app.id }] } } }
      })
      UI.message("team invitation: HTTP #{code}")
      (body["errors"] || []).each { |e| UI.message("  #{e['code']}: #{e['detail']}") }
      UI.user_error!("team invitation failed") unless code.start_with?("2")
      next
    end
    next if ENV["INVITE_GROUP"].to_s.empty?
    group = (groups["data"] || []).find { |g| g.dig("attributes", "name") == ENV["INVITE_GROUP"].to_s }
    UI.user_error!("no group named \"#{ENV['INVITE_GROUP']}\"") unless group
    code, body = asc.call(:post, "/v1/betaTesters", {
      data: { type: "betaTesters", attributes: { email: email },
              relationships: { betaGroups: { data: [{ type: "betaGroups", id: group["id"] }] } } }
    })
    UI.message("invite to \"#{group.dig('attributes', 'name')}\": HTTP #{code}")
    (body["errors"] || []).each { |e| UI.message("  #{e['code']}: #{e['detail']}") }
    UI.user_error!("invite failed") unless code.start_with?("2")
  end

  desc "Build and sign for the App Store without uploading (proves signing works)"
  lane :signed_build do
    archive
  end

  desc "Build the app and upload it to TestFlight"
  lane :beta do
    key = archive
    # The simulator-only test-gate path (BlogTab.swift) must not ship.
    sh(File.join(ROOT, "scripts/check-release-clean.sh"), Dir[File.join(ROOT, "build/ipa/*.ipa")].first.to_s)
    # No changelog: with one, fastlane waits for Apple to list the build before setting it,
    # and a build Apple rejects never appears, so the job ran into its time limit.
    upload_to_testflight(
      api_key: key,
      skip_waiting_for_build_processing: true
    )
  end
end
