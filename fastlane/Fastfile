# TestFlight for the iphoneblog chat app. Everything runs with an App Store Connect API key
# from repository secrets; nobody's Apple ID password is used. Setup: docs/apple-setup.md.
#
#   bundle exec fastlane ios register   identifiers and capabilities (Apple setup workflow)
#   bundle exec fastlane ios beta       build, sign and upload to TestFlight
#
# Environment:
#   ASC_KEY_ID, ASC_ISSUER_ID, ASC_KEY_P8_BASE64   the API key (secrets)
#   APPLE_TEAM_ID                                  the team (repository variable)
#   BUILD_NUMBER                                   CFBundleVersion for the upload

require "base64"
require "tmpdir"
require "securerandom"
require "shellwords"
require "xcodeproj"

default_platform(:ios)

ROOT = File.expand_path("..", __dir__)

def brand(key)
  value = File.read(File.join(ROOT, "brand.env"))[/^#{key}="?([^"\n]*)"?/, 1]
  UI.user_error!("brand.env has no #{key}") if value.to_s.empty?
  value
end

def team_id
  ENV.fetch("APPLE_TEAM_ID") { UI.user_error!("APPLE_TEAM_ID is not set") }
end

# Writes the key for xcodebuild (it needs a file) and returns fastlane's api_key hash.
def api_key
  @api_key ||= begin
    key_id = ENV.fetch("ASC_KEY_ID")
    path = File.join(Dir.tmpdir, "AuthKey_#{key_id}.p8")
    File.write(path, Base64.decode64(ENV.fetch("ASC_KEY_P8_BASE64")))
    File.chmod(0o600, path)
    @key_path = path
    app_store_connect_api_key(
      key_id: key_id,
      issuer_id: ENV.fetch("ASC_ISSUER_ID"),
      key_filepath: path,
      in_house: false
    )
  end
end

def app_store_profile(key, identifier, force: false)
  get_provisioning_profile(api_key: key, app_identifier: identifier, team_id: team_id, force: force,
                           output_path: File.join(ROOT, "build/profiles"))
  [lane_context[SharedValues::SIGH_NAME], lane_context[SharedValues::SIGH_PROFILE_PATH]]
end

def profile_has_group?(path, group)
  plist = `security cms -D -i #{Shellwords.escape(path)}`
  plist.include?("<string>#{group}</string>")
end

platform :ios do
  # Builds, signs and exports the App Store .ipa; returns the API key.
  # Signing is manual: the team's one Apple Distribution certificate comes from the
  # environment secrets DIST_CERT_P12_BASE64 and DIST_CERT_PASSWORD into a throwaway
  # keychain, and sigh fetches (or creates) the App Store profile through the API.
  # No device, no Apple ID, no xcodebuild login.
  private_lane :archive do
    key = api_key
    sh(File.join(ROOT, "scripts/configure.sh"))

    keychain = File.join(Dir.tmpdir, "iphoneblog-signing.keychain-db")
    keychain_password = SecureRandom.hex(24)
    create_keychain(path: keychain, password: keychain_password, default_keychain: false,
                    unlock: true, timeout: 3600, lock_when_sleeps: false, add_to_search_list: true)
    p12 = File.join(Dir.tmpdir, "distribution.p12")
    File.binwrite(p12, Base64.decode64(ENV.fetch("DIST_CERT_P12_BASE64")))
    File.chmod(0o600, p12)
    begin
      import_certificate(certificate_path: p12, certificate_password: ENV.fetch("DIST_CERT_PASSWORD"),
                         keychain_path: keychain, keychain_password: keychain_password, log_output: false)
    ensure
      File.delete(p12) if File.exist?(p12)
    end

    project = File.join(ROOT, "iphoneblog.xcodeproj")
    profiles = {}
    bundle_id = brand("BUNDLE_ID")
    group = brand("APP_GROUP_ID")
    { "App" => bundle_id, "NotificationExtension" => "#{bundle_id}.nse" }.each do |target, identifier|
      name, path = app_store_profile(key, identifier)
      # A profile made before the app group was tied to the id lacks it; make it once more.
      unless profile_has_group?(path, group)
        UI.important("#{identifier}: profile lacks #{group}, regenerating")
        name, path = app_store_profile(key, identifier, force: true)
        UI.user_error!("#{identifier}: #{group} is not tied to the id (docs/apple-setup.md step 6)") unless profile_has_group?(path, group)
      end
      profiles[identifier] = name
      update_code_signing_settings(path: project, targets: [target], use_automatic_signing: false,
                                   team_id: team_id, code_sign_identity: "Apple Distribution",
                                   profile_name: name, bundle_identifier: identifier)
    end

    # Frameworks built into the app (ChatKit) sign with the same identity and need no profile.
    Xcodeproj::Project.open(project).targets
                      .select { |t| t.product_type == "com.apple.product-type.framework" }
                      .each do |t|
      update_code_signing_settings(path: project, targets: [t.name], use_automatic_signing: false,
                                   team_id: team_id, code_sign_identity: "Apple Distribution")
    end

    build_app(
      project: project,
      scheme: "iphoneblog",
      configuration: "Release",
      output_directory: File.join(ROOT, "build/ipa"),
      codesigning_identity: "Apple Distribution",
      xcargs: [
        "-skipPackagePluginValidation",
        "-skipMacroValidation",
        "OTHER_CODE_SIGN_FLAGS='--keychain #{keychain}'",
        # Swift packages build frameworks and resource bundles (MatrixRustSDK, Kingfisher,
        # DTCoreText, Compound's tokens, ...) that are signed automatically unless told otherwise,
        # and automatic signing clashes with our identity. On the command line these reach every
        # target: manual, Apple Distribution, our team. Profiles stay per target in the project
        # (app and extension); frameworks and bundles need none.
        "DEVELOPMENT_TEAM=#{team_id}",
        "CODE_SIGN_STYLE=Manual",
        "CODE_SIGN_IDENTITY='Apple Distribution'",
        "CURRENT_PROJECT_VERSION=#{ENV.fetch('BUILD_NUMBER')}"
      ].join(" "),
      export_team_id: team_id,
      export_options: {
        method: "app-store-connect",
        signingStyle: "manual",
        teamID: team_id,
        signingCertificate: "Apple Distribution",
        provisioningProfiles: profiles
      }
    )

    key
  end

  desc "Register the bundle ids and switch on their capabilities through the API"
  lane :register do
    Spaceship::ConnectAPI.token = Spaceship::ConnectAPI::Token.from(hash: api_key)
    bundle_id = brand("BUNDLE_ID")
    store_name = brand("APP_STORE_NAME")
    ids = {
      bundle_id => store_name,
      "#{bundle_id}.nse" => "#{store_name} Notifications"
    }
    caps = Spaceship::ConnectAPI::BundleIdCapability::Type
    ids.each do |identifier, name|
      bundle = Spaceship::ConnectAPI::BundleId.find(identifier)
      if bundle
        UI.message("#{identifier}: already registered")
      else
        bundle = Spaceship::ConnectAPI::BundleId.create(name: name, platform: "IOS", identifier: identifier)
        UI.success("#{identifier}: registered")
      end
      # The app receives pushes; app and extension share the app group.
      wanted = identifier == bundle_id ? [caps::PUSH_NOTIFICATIONS, caps::APP_GROUPS] : [caps::APP_GROUPS]
      present = bundle.get_capabilities.map(&:capability_type)
      wanted.each do |cap|
        if present.include?(cap)
          UI.message("#{identifier}: #{cap} already on")
        else
          # POST /v1/bundleIdCapabilities. update_capability (PATCH on the bundle id) answers
          # "Unauthenticated" for an API key.
          bundle.create_capability(cap)
          UI.success("#{identifier}: #{cap} on")
        end
      end
    end
  end

  desc "Create the team's Apple Distribution certificate from a CSR (certificate workflow)"
  lane :create_certificate do
    Spaceship::ConnectAPI.token = Spaceship::ConnectAPI::Token.from(hash: api_key)
    csr = ENV.fetch("CSR_PEM")
    UI.user_error!("CSR_PEM is not a certificate signing request") unless csr.include?("BEGIN CERTIFICATE REQUEST")

    existing = Spaceship::ConnectAPI::Certificate.all(filter: { certificateType: "DISTRIBUTION" })
    existing.each { |c| UI.message("existing: #{c.name} #{c.serial_number} until #{c.expiration_date}") }

    cert = Spaceship::ConnectAPI::Certificate.create(certificate_type: "DISTRIBUTION", csr_content: csr)
    UI.success("created: #{cert.name} #{cert.serial_number} until #{cert.expiration_date}")
    # The certificate is public (it holds no private key); printing it is safe.
    puts "CERTIFICATE_BASE64_BEGIN"
    puts cert.certificate_content
    puts "CERTIFICATE_BASE64_END"
  end

  desc "Build and sign for the App Store without uploading (proves signing works)"
  lane :signed_build do
    archive
  end

  desc "Build the app and upload it to TestFlight"
  lane :beta do
    key = archive
    upload_to_testflight(
      api_key: key,
      skip_waiting_for_build_processing: true,
      changelog: "Build #{ENV.fetch('BUILD_NUMBER')} from #{ENV.fetch('GITHUB_SHA', 'local')[0, 7]}."
    )
  end
end
