# The one place for everything that names or signs the app.
# scripts/prepare.sh reads this file; nothing else holds these values.

# Name under the icon on the home screen. Keep it at 12 characters or fewer.
APP_DISPLAY_NAME="iphoneblog"

# Apple team and identifiers. TEAM_ID is a placeholder until Alex's company
# developer account exists; simulator builds do not sign, so it does no harm.
TEAM_ID="XXXXXXXXXX"
BUNDLE_ID="de.iphoneblog.matrix"
APP_GROUP_ID="group.de.iphoneblog.matrix"

# The Matrix server. Server name, client API and push gateway share one host.
MATRIX_SERVER_NAME="matrix.iphoneblog.de"
MATRIX_BASE_URL="https://matrix.iphoneblog.de"
PUSH_GATEWAY_BASE_URL="https://matrix.iphoneblog.de"

# Web pages the app and the sign-in service show. The OAuth client metadata
# (client, logo, terms, privacy, redirect) must sit on one host, so these live on
# the Matrix host and redirect to the blog where needed.
WEBSITE_URL="https://matrix.iphoneblog.de"
LOGO_URL="https://matrix.iphoneblog.de/app/logo.png"
COPYRIGHT_URL="https://matrix.iphoneblog.de/app/impressum"
TERMS_URL="https://matrix.iphoneblog.de/app/terms"
PRIVACY_URL="https://matrix.iphoneblog.de/app/privacy"

# Brand colours, from the blog's theme (theme-color #149791).
BRAND_COLOR="#149791"
BRAND_COLOR_DARK_TEXT="#0F7D78"
BRAND_COLOR_LIGHT_ON_DARK="#3CC4BC"
