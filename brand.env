# The one place for everything that names, signs or points the app somewhere.
# scripts/configure.sh turns it into App/Generated/Brand.swift and the xcodegen
# variables; nothing else holds these values.

# Name under the icon on the home screen. Keep it at 12 characters or fewer.
APP_DISPLAY_NAME="iphoneblog"

# Apple identifiers. Until Alex's company account exists the app ships as a preview
# under Thorsten's personal developer team; the release later uses de.iphoneblog.matrix.
# Extensions derive from BUNDLE_ID: the notification service extension is BUNDLE_ID.nse.
BUNDLE_ID="de.iphoneblog.matrix.preview"
APP_GROUP_ID="group.de.iphoneblog.matrix.preview"
# The team id is not kept here: CI reads the repository variable APPLE_TEAM_ID, and
# locally scripts/configure.sh takes it from the environment. Without it, builds are unsigned.

# The app record in App Store Connect (docs/apple-setup.md). The store name must be unique
# across the App Store; the name under the icon is APP_DISPLAY_NAME.
APP_STORE_NAME="iphoneblog Chat Preview"
APP_SKU="iphoneblog-matrix-preview"

# The Matrix server. People are @name:iphoneblog.de; the client API lives on its own
# host and is preset, so iphoneblog.de needs no .well-known/matrix.
MATRIX_SERVER_NAME="iphoneblog.de"
MATRIX_HOMESERVER_URL="https://chat.iphoneblog.de"

# Sign-in through the Matrix Authentication Service (OAuth 2.0). With OAUTH_CLIENT_ID set,
# the app signs in as that static MAS client; WordPress's web-login accepts only its tokens.
# Empty: the app registers itself dynamically (test servers). MAS requires a custom redirect
# scheme to be the reverse of the client URI's host.
OAUTH_CLIENT_ID="01M7GHM07J2V93A0P3Z0MBM60C"
OAUTH_ISSUER_URL="https://auth.iphoneblog.de/"
OAUTH_CLIENT_URI="https://chat.iphoneblog.de/app"
OAUTH_REDIRECT_URI="de.iphoneblog.chat:/oauth/callback"
# The pair before the move to chat.iphoneblog.de; works while matrix.iphoneblog.de stays an alias.
OAUTH_LEGACY_REDIRECT_SCHEME="de.iphoneblog.matrix"
OAUTH_LOGO_URI="https://chat.iphoneblog.de/app/logo.png"
OAUTH_TOS_URI="https://chat.iphoneblog.de/app/terms"
OAUTH_POLICY_URI="https://chat.iphoneblog.de/app/privacy"

# The rooms the navigation is built on (decisions 2026-11-15). The Blog room holds one thread
# per article, readable by everyone; members of #one are joined to the #one room.
BLOG_ROOM_ALIAS="#blog:iphoneblog.de"
ONE_ROOM_ALIAS="#one:iphoneblog.de"
# The one channel of #one-Chat, a child of the space #one.
ONE_CHANNEL_ALIAS="#allgemein:iphoneblog.de"
# Signed-out reading of the Blog room: a read-only JSON API on the Matrix host.
BLOG_API_URL="https://chat.iphoneblog.de/_iphoneblog/v1/blog"
# The Blog tab: the blog itself, as the app view (WordPress keeps app=1 on its links).
# beta while it is tested, www once it is live.
BLOG_WEB_URL="https://beta.iphoneblog.de/?app=1"
# Where a non-member learns about #one.
ONE_OFFER_URL="https://www.iphoneblog.de/one/"
REGISTER_URL="https://www.iphoneblog.de/anmelden/"
IMPRINT_URL="https://www.iphoneblog.de/impressum/"

# Push through our own Sygnal. Its app id is BUNDLE_ID + ".ios.prod"; the APNs topic is BUNDLE_ID.
PUSH_GATEWAY_URL="https://chat.iphoneblog.de/_matrix/push/v1/notify"

# Brand colours, from the blog's theme.
BRAND_TEAL="#149791"
BRAND_TEAL_TEXT="#0F7D78"
BRAND_TEAL_ON_DARK="#3DB8B1"
BRAND_CORAL="#EB686E"
BRAND_CORAL_ON_DARK="#EB686E"
