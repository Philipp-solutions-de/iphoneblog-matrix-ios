# The one place for everything that names, signs or points the app somewhere.
# scripts/configure.sh turns it into App/Generated/Brand.swift and the xcodegen
# variables; nothing else holds these values.

# Name under the icon on the home screen. Keep it at 12 characters or fewer.
APP_DISPLAY_NAME="iphoneblog"

# Apple identifiers. Until Alex's company account exists the app ships as a preview
# under Thorsten's personal developer team; the release later uses de.iphoneblog.matrix.
# Extensions derive from BUNDLE_ID: the notification service extension is BUNDLE_ID.nse.
BUNDLE_ID="de.iphoneblog.matrix.preview"
APP_GROUP_ID="group.de.iphoneblog.matrix.preview"
# The team id is not kept here: CI reads the repository variable APPLE_TEAM_ID, and
# locally scripts/configure.sh takes it from the environment. Without it, builds are unsigned.

# The app record in App Store Connect (docs/apple-setup.md). The store name must be unique
# across the App Store; the name under the icon is APP_DISPLAY_NAME.
APP_STORE_NAME="iphoneblog Chat Preview"
APP_SKU="iphoneblog-matrix-preview"

# The Matrix server. People are @name:iphoneblog.de; the client API lives on its own
# host and is preset, so iphoneblog.de needs no .well-known/matrix.
MATRIX_SERVER_NAME="iphoneblog.de"
MATRIX_HOMESERVER_URL="https://matrix.iphoneblog.de"

# Sign-in through the Matrix Authentication Service (OAuth 2.0). The app registers
# itself dynamically. MAS requires the custom redirect scheme to be the reverse of the
# client URI's host, so the scheme de.iphoneblog.matrix belongs to matrix.iphoneblog.de.
OAUTH_CLIENT_URI="https://matrix.iphoneblog.de/app"
OAUTH_REDIRECT_URI="de.iphoneblog.matrix:/oauth/callback"
OAUTH_LOGO_URI="https://matrix.iphoneblog.de/app/logo.png"
OAUTH_TOS_URI="https://matrix.iphoneblog.de/app/terms"
OAUTH_POLICY_URI="https://matrix.iphoneblog.de/app/privacy"

# Push through our own Sygnal. Its app id is BUNDLE_ID + ".ios.prod"; the APNs topic is BUNDLE_ID.
PUSH_GATEWAY_URL="https://matrix.iphoneblog.de/_matrix/push/v1/notify"

# Brand colours, from the blog's theme.
BRAND_TEAL="#149791"
BRAND_TEAL_TEXT="#0F7D78"
BRAND_TEAL_ON_DARK="#3CC4BC"
BRAND_CORAL="#EB686E"
